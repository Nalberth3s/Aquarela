# URL da API (docker compose sobe em http://localhost:3333)
VITE_API_URL=http://localhost:3333
# "true" = modo demonstração com dados locais (sem servidor)
VITE_USE_MOCKS=false
# Endereço público do site (Google, WhatsApp, sitemap). Troque pelo domínio ao publicar.
VITE_SITE_URL=http://localhost:5173
